{
  "name": "prism",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PRISM - a top-down geometric dungeon roguelike shooter",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/write-build-info.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "build:offline": "tsc --noEmit && node scripts/build-offline.mjs",
    "server:build": "tsc --noEmit && node scripts/build-server.mjs",
    "server": "node dist-server/server.mjs",
    "build:all": "npm run build && npm run server:build",
    "server:package": "npm run build:all && node scripts/package-server.mjs",
    "bench:sync": "vite-node scripts/benchmark-sync.ts"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "eslint": "^9.13.0",
    "fflate": "0.8.3",
    "happy-dom": "21.0.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "ws": "8.22.1"
  }
}
